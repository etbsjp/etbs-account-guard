<?xml version="1.0"?>
<ruleset name="etbs-account-guard">
    <description>etbs-account-guard 用の PHPCS 設定（WordPress-Extra）。CI では phpcs-changed により PR の差分行にのみ適用する。</description>

    <!-- 対象は追跡されている .php ファイル -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- 第三者コード（plugin-update-checker）は指摘対象から除外する -->
    <exclude-pattern>*/inc/plugin-update-checker/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- PHPUnit テスト（tests/）は配布しないコードのため対象から除外する。
         bootstrap は WordPress の関数を最小限のスタブとして再定義しており、ファイル名の規則（class-*.php）なども
         PHPUnit の慣習（*Test.php）と合わないため、本体と同じ WordPress-Extra を当てると本質的でない指摘が積み上がる。 -->
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>

    <rule ref="WordPress-Extra"/>

    <!--
        WordPress-Extra が参照する WordPress.Security.* は EscapeOutput / SafeRedirect / NonceVerification /
        PluginMenuSlug の4つだけで、入力のサニタイズを見る ValidatedSanitizedInput が入っていない。
        認証を扱うプラグインでここが外れていると「0 ERROR で緑」がサニタイズ衛生の証拠にならないため、明示的に足す。
    -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
</ruleset>
